<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="LuminaRamPresetButton" TargetType="Button" BasedOn="{StaticResource LuminaSecondaryButton}">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
        <Setter Property="MinWidth" Value="66"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- RAM is the only Slider in the current settings surface. The template keeps the
         advanced slider while putting the common choices first as large, readable presets. -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource LuminaAccentBrush}"/>
        <Setter Property="MinHeight" Value="78"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Style="{StaticResource LuminaRamPresetButton}" Tag="ram:4096" Content="4 GB"/>
                            <Button Style="{StaticResource LuminaRamPresetButton}" Tag="ram:6144" Content="6 GB"/>
                            <Button Style="{StaticResource LuminaRamPresetButton}" Tag="ram:8192" Content="8 GB"/>
                            <Button Style="{StaticResource LuminaRamPresetButton}" Tag="ram:12288" Content="12 GB"/>
                            <Button Style="{StaticResource LuminaRamPresetButton}" Tag="ram:16384" Content="16 GB" Margin="0"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="3,0">
                            <Border Height="6" CornerRadius="3" Background="#1C2638" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   Orientation="Horizontal"
                                   IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="{StaticResource LuminaAccentGradient}" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#F4F6FB" Stroke="#8B5CF6" StrokeThickness="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
