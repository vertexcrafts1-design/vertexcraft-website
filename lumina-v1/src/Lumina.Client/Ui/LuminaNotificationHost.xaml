<UserControl x:Class="Lumina.Client.Ui.LuminaNotificationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Lumina.Client.Ui"
             Background="Transparent"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <Grid Background="Transparent">
        <ItemsControl x:Name="ToastList"
                      ItemsSource="{Binding Notifications}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,74,22,0"
                      Panel.ZIndex="20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Width="360"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type ui:LuminaNotification}">
                    <Border Style="{StaticResource LuminaToastCard}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="KindBar" CornerRadius="3" Background="{StaticResource LuminaInfo}"/>
                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Message}" Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource LuminaTextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2" Width="30" Height="30" Padding="0" VerticalAlignment="Top"
                                    Style="{StaticResource LuminaSecondaryButton}" Content="×" Tag="{Binding}" Click="Dismiss_Click"/>
                        </Grid>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource LuminaToastCard}"/>
                        </Border.Style>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Success"><Setter TargetName="KindBar" Property="Background" Value="{StaticResource LuminaSuccess}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Info"><Setter TargetName="KindBar" Property="Background" Value="{StaticResource LuminaInfo}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter TargetName="KindBar" Property="Background" Value="{StaticResource LuminaWarning}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter TargetName="KindBar" Property="Background" Value="{StaticResource LuminaDanger}"/></DataTrigger>
                        </DataTemplate.Triggers>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid x:Name="ModalLayer" Visibility="Collapsed" Background="#B3000000" Panel.ZIndex="100">
            <Border Style="{StaticResource LuminaModalCard}"
                    Width="480"
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border Width="46" Height="46" CornerRadius="14" Background="#2A2146" HorizontalAlignment="Left">
                        <TextBlock Text="!" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="#DCCBFF"/>
                    </Border>
                    <TextBlock Text="{Binding ActiveConfirmation.Title}" Margin="0,18,0,0" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ActiveConfirmation.Message}" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource LuminaTextMuted}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Style="{StaticResource LuminaSecondaryButton}" Content="Abbrechen" Click="CancelConfirmation_Click"/>
                        <Button x:Name="ConfirmButton" Style="{StaticResource LuminaPrimaryButton}" Margin="10,0,0,0"
                                Content="{Binding ActiveConfirmation.ConfirmText}" Click="Confirm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
