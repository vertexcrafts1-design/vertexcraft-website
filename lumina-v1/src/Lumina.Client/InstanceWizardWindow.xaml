<Window x:Class="Lumina.Client.InstanceWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LUMINA · Instanz" Width="920" Height="650"
        MinWidth="920" MinHeight="650" MaxWidth="920" MaxHeight="650"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        Background="{StaticResource LuminaWindowBackground}" Foreground="{StaticResource LuminaText}">
    <Border Background="{StaticResource LuminaWindowBackground}" BorderBrush="#303A55" BorderThickness="1" CornerRadius="20" Padding="28">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="WizardTitle" Text="Neue Instanz" FontSize="26" FontWeight="Bold"/>
                    <TextBlock x:Name="WizardSubtitle" Text="Schritt 1 von 5 · Name" Margin="0,5,0,0" FontSize="10.5" Foreground="{StaticResource LuminaTextMuted}"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#101727" BorderBrush="#27324A" BorderThickness="1" CornerRadius="11" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource LuminaSuccess}" Margin="0,0,7,0"/><TextBlock x:Name="AccountLabel" Text="Microsoft angemeldet" FontSize="9.5" Foreground="#B4BDD0"/></StackPanel>
                </Border>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="5" Margin="0,22,0,18">
                <Border x:Name="Step1Badge" Background="#6F55E8" CornerRadius="10" Padding="10,8" Margin="0,0,5,0"><TextBlock Text="1 · Name" HorizontalAlignment="Center" FontSize="9.5" FontWeight="SemiBold"/></Border>
                <Border x:Name="Step2Badge" Background="#111827" CornerRadius="10" Padding="10,8" Margin="2"><TextBlock Text="2 · Minecraft" HorizontalAlignment="Center" FontSize="9.5" Foreground="#8B96AC"/></Border>
                <Border x:Name="Step3Badge" Background="#111827" CornerRadius="10" Padding="10,8" Margin="2"><TextBlock Text="3 · Loader" HorizontalAlignment="Center" FontSize="9.5" Foreground="#8B96AC"/></Border>
                <Border x:Name="Step4Badge" Background="#111827" CornerRadius="10" Padding="10,8" Margin="2"><TextBlock Text="4 · Version" HorizontalAlignment="Center" FontSize="9.5" Foreground="#8B96AC"/></Border>
                <Border x:Name="Step5Badge" Background="#111827" CornerRadius="10" Padding="10,8" Margin="5,0,0,0"><TextBlock Text="5 · Fertig" HorizontalAlignment="Center" FontSize="9.5" Foreground="#8B96AC"/></Border>
            </UniformGrid>

            <Border Grid.Row="2" Style="{StaticResource LuminaCard}" Padding="30">
                <Grid>
                    <Grid x:Name="NameStep">
                        <StackPanel VerticalAlignment="Center" MaxWidth="570">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#211B38" HorizontalAlignment="Left"><TextBlock Text="01" FontSize="14" FontWeight="Bold" Foreground="#B99CFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Wie soll deine Instanz heißen?" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,0"/>
                            <TextBlock Text="Ein kurzer Name reicht. Version und Loader wählst du in den nächsten Schritten." TextWrapping="Wrap" Margin="0,7,0,20" FontSize="10.5" Foreground="#8691A7"/>
                            <TextBlock Text="INSTANZNAME" FontSize="8" FontWeight="Bold" Foreground="#6D7991" Margin="1,0,0,7"/>
                            <TextBox x:Name="NameText" TextChanged="WizardValue_Changed"/>
                            <TextBlock x:Name="NameError" Text="" Margin="1,9,0,0" FontSize="9.5" Foreground="#FF8798"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="MinecraftStep" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" MaxWidth="610">
                            <TextBlock Text="Minecraft-Version" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CurrentVersionHint" Text="Wähle eine konkrete Version aus dem offiziellen Minecraft-Katalog." TextWrapping="Wrap" Margin="0,7,0,20" FontSize="10.5" Foreground="#8691A7"/>
                            <TextBlock Text="VERSION" FontSize="8" FontWeight="Bold" Foreground="#6D7991" Margin="1,0,0,7"/>
                            <ComboBox x:Name="MinecraftCombo" Style="{StaticResource LuminaComboBox}" DisplayMemberPath="DisplayName" SelectionChanged="Minecraft_Changed"/>
                            <CheckBox x:Name="SnapshotsCheck" Style="{StaticResource LuminaToggle}" Margin="0,14,0,0" Checked="Snapshots_Changed" Unchecked="Snapshots_Changed"><StackPanel><TextBlock Text="Snapshots anzeigen" FontWeight="SemiBold"/><TextBlock Text="Nur aktivieren, wenn du bewusst Testversionen verwenden möchtest." FontSize="8.5" Foreground="#748198"/></StackPanel></CheckBox>
                            <TextBlock x:Name="MinecraftStatus" Text="Lade Minecraft-Katalog …" Margin="1,11,0,0" FontSize="9.5" Foreground="#7E899F"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="LoaderStep" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Wie möchtest du Minecraft starten?" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Vanilla für Standard-Minecraft oder ein Loader für Mods. LUMINA prüft danach automatisch die passenden Versionen." TextWrapping="Wrap" Margin="0,7,0,18" FontSize="10.5" Foreground="#8691A7"/>
                            <UniformGrid Columns="5">
                                <Button x:Name="VanillaLoaderCard" Tag="Vanilla" Click="LoaderCard_Click" Style="{StaticResource LuminaSecondaryButton}" Margin="0,0,5,0" Padding="10,18"><StackPanel><TextBlock Text="◆" FontSize="22" Foreground="#9BC779" HorizontalAlignment="Center"/><TextBlock FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center">Vanilla</TextBlock><TextBlock Text="Standard" FontSize="8" Foreground="#748198" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
                                <Button x:Name="FabricLoaderCard" Tag="Fabric" Click="LoaderCard_Click" Style="{StaticResource LuminaSecondaryButton}" Margin="2.5,0" Padding="10,18"><StackPanel><TextBlock Text="F" FontSize="22" FontWeight="Bold" Foreground="#D4B483" HorizontalAlignment="Center"/><TextBlock FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center">Fabric</TextBlock><TextBlock Text="leicht &amp; schnell" FontSize="8" Foreground="#748198" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
                                <Button x:Name="QuiltLoaderCard" Tag="Quilt" Click="LoaderCard_Click" Style="{StaticResource LuminaSecondaryButton}" Margin="2.5,0" Padding="10,18"><StackPanel><TextBlock Text="Q" FontSize="22" FontWeight="Bold" Foreground="#B89AFF" HorizontalAlignment="Center"/><TextBlock FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center">Quilt</TextBlock><TextBlock Text="modern" FontSize="8" Foreground="#748198" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
                                <Button x:Name="ForgeLoaderCard" Tag="Forge" Click="LoaderCard_Click" Style="{StaticResource LuminaSecondaryButton}" Margin="2.5,0" Padding="10,18"><StackPanel><TextBlock Text="⚒" FontSize="21" Foreground="#D48E6E" HorizontalAlignment="Center"/><TextBlock FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center">Forge</TextBlock><TextBlock Text="klassisch" FontSize="8" Foreground="#748198" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
                                <Button x:Name="NeoForgeLoaderCard" Tag="NeoForge" Click="LoaderCard_Click" Style="{StaticResource LuminaSecondaryButton}" Margin="5,0,0,0" Padding="10,18"><StackPanel><TextBlock Text="N" FontSize="22" FontWeight="Bold" Foreground="#69D8FF" HorizontalAlignment="Center"/><TextBlock FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center">NeoForge</TextBlock><TextBlock Text="aktuell" FontSize="8" Foreground="#748198" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
                            </UniformGrid>
                            <ComboBox x:Name="LoaderCombo" Visibility="Collapsed" SelectionChanged="Loader_Changed"/>
                            <TextBlock x:Name="LoaderStatus" Text="" Margin="1,14,0,0" FontSize="9.5" Foreground="#8490A6"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="LoaderVersionStep" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" MaxWidth="610">
                            <TextBlock Text="Loader-Version" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LoaderVersionDescription" Text="Wähle die konkrete Loader-Version." TextWrapping="Wrap" Margin="0,7,0,20" FontSize="10.5" Foreground="#8691A7"/>
                            <Border Background="#0A101B" BorderBrush="#222E45" BorderThickness="1" CornerRadius="14" Padding="18">
                                <StackPanel><TextBlock Text="KOMPATIBLE VERSION" FontSize="8" FontWeight="Bold" Foreground="#6D7991"/><ComboBox x:Name="LoaderVersionCombo" Style="{StaticResource LuminaComboBox}" Margin="0,8,0,0" SelectionChanged="WizardValue_Changed"/></StackPanel>
                            </Border>
                            <TextBlock x:Name="LoaderVersionStatus" Text="" Margin="1,12,0,0" FontSize="9.5" Foreground="#8490A6"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="SummaryStep" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" MaxWidth="640">
                            <TextBlock Text="Zusammenfassung" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="LUMINA speichert nur diese konkreten Werte. Es werden keine latest-* Platzhalter verwendet." TextWrapping="Wrap" Margin="0,7,0,18" FontSize="10.5" Foreground="#8691A7"/>
                            <Border Background="#0A101B" BorderBrush="#222E45" BorderThickness="1" CornerRadius="15" Padding="19"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="NAME" FontSize="8" Foreground="#69758C"/><TextBlock Grid.Column="1" x:Name="SummaryName" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Grid.Row="1" Text="MINECRAFT" Margin="0,13,0,0" FontSize="8" Foreground="#69758C"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="SummaryMinecraft" Margin="0,13,0,0" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Grid.Row="2" Text="LOADER" Margin="0,13,0,0" FontSize="8" Foreground="#69758C"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="SummaryLoader" Margin="0,13,0,0" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Grid.Row="3" Text="LOADER VERSION" Margin="0,13,0,0" FontSize="8" Foreground="#69758C"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="SummaryLoaderVersion" Margin="0,13,0,0" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid></Border>
                            <Border x:Name="ValidationBox" Background="#10241D" BorderBrush="#235B48" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,13,0,0"><TextBlock x:Name="ValidationText" Text="Konfiguration ist gültig." FontSize="9.5" Foreground="#72E0AE" TextWrapping="Wrap"/></Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Style="{StaticResource LuminaSecondaryButton}" Click="Cancel_Click" Content="Abbrechen"/>
                <TextBlock Grid.Column="1" x:Name="FooterStatus" Text="" VerticalAlignment="Center" Margin="14,0" FontSize="9.5" Foreground="#7D879B"/>
                <Button Grid.Column="2" x:Name="BackButton" Style="{StaticResource LuminaSecondaryButton}" Click="Back_Click" Content="← Zurück" Visibility="Collapsed"/>
                <Button Grid.Column="3" x:Name="NextButton" Style="{StaticResource LuminaPrimaryButton}" Click="Next_Click" Margin="9,0,0,0" Content="Weiter →"/>
                <Button Grid.Column="3" x:Name="CreateButton" Style="{StaticResource LuminaPrimaryButton}" Click="Create_Click" Margin="9,0,0,0" Content="Instanz erstellen" Visibility="Collapsed" IsEnabled="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
